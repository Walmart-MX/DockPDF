/**
 * core/angle.js
 *
 * Responsabilidad:
 *   Normalizar un ángulo de rotación a un valor entre 0 y 359.
 *   Idéntico a normalizeAngle() en index.html v1.0.
 *
 * Entrada: a (number) — ángulo, puede ser negativo o mayor a 360
 * Salida: number — ángulo normalizado en [0, 360)
 *
 * No puede: nada más — es una función pura de una línea.
 *
 * NOTA: si ya tienes core/angle.js con esta misma función desde tu Fase 1,
 * usa esa versión y descarta este archivo — se incluye aquí solo para que
 * pdfWriteService.js tenga la dependencia resuelta de forma autocontenida.
 */
 
export function normalizeAngle(a) {
  return ((a % 360) + 360) % 360;
}
